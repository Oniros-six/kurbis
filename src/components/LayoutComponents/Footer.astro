---
import { ArrowRight, ArrowLeft, Youtube, Facebook, Instagram, Phone } from 'lucide-react';
import { SocialMediaLinks } from '@/components/LayoutComponents/SocialMediaLinks';
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

const activeClass = 'text-[var(--color-primario)]';
const linkBase = 'flex items-center gap-2';
const message = 'Hola, quiero más información sobre sus productos';
const url = `https://wa.me/+59894398865?text=${encodeURIComponent(message)}`;
---

<div class="flex flex-col bg-[var(--color-secundario)]">
  <div class="h-[1px] bg-gradient-to-r from-[var(--color-primario)]/0 via-[var(--color-primario)] to-[var(--color-primario)]/0"></div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 text-white px-8 py-12 gap-y-8 sm:gap-x-9 xl:gap-x-30">
    <div class="sm:order-1">
      <img src="/logotype.webp" alt="logotype de Kürbis" class="w-35 mb-2" />
      <div class="font-medium">
        Atanasio Sierra y Ayacucho<br />Piriápolis, Uruguay<br />
      </div>
    </div>

    <div class="sm:order-2">
      <ul class="text-lg font-medium space-y-4">
        <li class="grid grid-cols-5 items-center">
          <a href="/" class={`col-span-4 ${linkBase} ${isActive('/') ? activeClass : ''}`}>Inicio</a>
          {isActive('/') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li class="grid grid-cols-5 items-center">
          <a href="/productos" class={`col-span-4 ${linkBase} ${isActive('/productos') ? activeClass : ''}`}>Nuestros productos</a>
          {isActive('/productos') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li class="grid grid-cols-5 items-center">
          <a href="/recetas" class={`col-span-4 ${linkBase} ${isActive('/recetas') ? activeClass : ''}`}>Recetas</a>
          {isActive('/recetas') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
      </ul>
    </div>

    <div class="sm:order-3">
      <ul class="text-lg font-medium space-y-4">
        <li class="font-bold text-center">Acerca de Kürbis</li>
        <li class="grid grid-cols-5 items-center">
          <a href="/nosotros" class={`col-span-4 ${linkBase} ${isActive('/nosotros') ? activeClass : ''}`}>Nosotros</a>
          {isActive('/nosotros') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li class="grid grid-cols-5 items-center">
          <a href="/mision" class={`col-span-4 ${linkBase} ${isActive('/mision') ? activeClass : ''}`}>Misión</a>
          {isActive('/mision') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li class="grid grid-cols-5 items-center">
          <a href="/sostenibilidad" class={`col-span-4 ${linkBase} ${isActive('/sostenibilidad') ? activeClass : ''}`}>Sostenibilidad</a>
          {isActive('/sostenibilidad') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
      </ul>
    </div>

    <div class="sm:order-4">
      <ul class="text-lg font-medium space-y-4">
        <li class="grid grid-cols-5 items-center">
          <a href="/contacto" class={`col-span-4 ${linkBase} ${isActive('/contacto') ? activeClass : ''}`}>Contacto</a>
          {isActive('/contacto') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li class="grid grid-cols-5 items-center">
          <a href="/faq" class={`col-span-4 ${linkBase} ${isActive('/faq') ? activeClass : ''}`}>Preguntas Frecuentes</a>
          {isActive('/faq') ? <ArrowLeft className={`justify-self-end ${activeClass}`} size={18} /> : <ArrowRight className="justify-self-end" size={18} />}
        </li>
        <li>
          <ul class="space-y-2">
            <li>
              <a href="mailto:office@kurbis.com.uy?subject=Nueva%20Consulta">office@kurbis.com.uy</a>
            </li>
            <li class="flex gap-2 align-center">
              <Phone />
              <a href={url} target="new_blank">094 398 865</a>
            </li>
            <li>
              <SocialMediaLinks client:load />
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
  <div class="flex flex-col items-center mt-10 mb-5">
    <a href="#" target="_blank" rel="noopener noreferrer" class="font-bold text-white text-sm hover:text-[var(--color-primario)] hover:scale-105 transition-all duration-100">Digital Kingdom</a>
    <div class="text-white">© 2025 Kürbis</div>
  </div>
</div>
