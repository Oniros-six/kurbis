    font-size: clamp(1.7rem, 6vw, 2.4rem);
    line-height: 1.15;
    color: #2e5a44;
  }
  .subtitle {
    margin-top: 0.5rem;
    font-size: 1.2rem;
    color: #555;
  }
  .intro {
    margin-bottom: 2.25rem;
  }
  section {
    margin-bottom: 2.25rem;
  }
  h2 {
    font-size: 1.6rem;
    line-height: 1.25;
    color: #2e5a44;
    margin-bottom: 0.75rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.7rem;
  }
  li::before {
    content: '•';
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .warning {
    margin-top: 2.5rem;
    padding: 1.1rem 1.25rem 0.5rem;
    background: #fff3cd;
    border: 1px solid #ffebaa;
    color: #856404;
    font-size: 0.95rem;
  }
  .warning h2 {
    font-size: 1rem;
    color: #856404;
    margin-bottom: 1rem;
  }
  .disclaimer {
    margin-top: 1.75rem;
    text-align: center;
    font-size: 0.8rem;
    color: #777;
  }
  @media (min-width: 640px) {
    .intro,
    li {
      text-align: justify;
    }
  }
</style>
